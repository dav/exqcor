<h1>Users</h1>

<div class="actions">
  <%= link_to "New User", new_admin_user_path %>
</div>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Admin</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.email_address, admin_user_path(user) %></td>
        <td><%= user.admin? ? "Yes" : "No" %></td>
        <td class="actions">
          <%= link_to "Edit", edit_admin_user_path(user) %>
          <%= link_to "Delete", admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: "Delete this user?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
